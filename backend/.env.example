# --- Chain ---
# publicnode allows eth_getLogs (the bnbchain.org seed RPCs refuse it, which breaks the poisoning history check)
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Hot key for the relayer bot. Testnet only — it pays gas, never holds user funds.
RELAYER_PRIVATE_KEY=0x
# From `forge script script/Deploy.s.sol` output
KURIR_RELAYER_ADDRESS=0x
TOKEN_ADDRESS=0x

# --- Relayer economics ---
# Fee the relayer asks for, in whole tokens (tUSD). Frontend reads this from GET /config.
RELAYER_FEE=0.5

# --- Guard ---
# Comma-separated known-bad addresses (hard block)
SCAM_LIST=
# Poisoning check: how many leading/trailing hex chars must match to count as a lookalike
POISON_MATCH_CHARS=4
# With no send history to compare against, sends above this (whole tokens) to a fresh address get flagged
LARGE_SEND_THRESHOLD=500
# Block KurirRelayer was deployed in (see broadcast/Deploy.s.sol/97/run-latest.json). When set, the
# poisoning check scans every Relayed event since deployment, not just the recent window below.
KURIR_DEPLOY_BLOCK=133031061
# Fallback window if the RPC refuses the full range (5,000 blocks ≈ 37 min on BSC testnet)
LOG_LOOKBACK_BLOCKS=5000

# --- LLM explanations (optional) ---
# Leave empty to use built-in Indonesian templates — zero API cost.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=8787
