# --- Chain ---
# publicnode allows eth_getLogs (the bnbchain.org seed RPCs refuse it, which breaks the poisoning history check)
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Failover + hedged reads (needn't support eth_getLogs)
RPC_URL_FALLBACK=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Abandon a stuck request after this and fail over (public RPCs stall on ~1 in 5 requests)
RPC_TIMEOUT_MS=3000
# Startup history backfill: publicnode prunes logs older than ~80k blocks; onfinality keeps
# full history in 5k-block ranges
ARCHIVE_RPC_URL=https://bnb-testnet.api.onfinality.io/public
ARCHIVE_CHUNK_BLOCKS=5000
# Guard reports CHECKS_DEGRADED if the history index has not caught up for this long
HISTORY_STALE_MS=60000
# Hot key for the relayer bot. Testnet only — it pays gas, never holds user funds.
RELAYER_PRIVATE_KEY=0x
# From `forge script script/Deploy.s.sol` output
KURIR_RELAYER_ADDRESS=0x
TOKEN_ADDRESS=0x

# --- Relayer economics ---
# Fee the relayer asks for, in whole tokens (tUSD). Frontend reads this from GET /config.
RELAYER_FEE=0.5

# --- Guard ---
# Comma-separated known-bad addresses (hard block)
SCAM_LIST=
# Poisoning check: how many leading/trailing hex chars must match to count as a lookalike
POISON_MATCH_CHARS=4
# With no send history to compare against, sends above this (whole tokens) to a fresh address get flagged
LARGE_SEND_THRESHOLD=500
# Block KurirRelayer was deployed in (see broadcast/Deploy.s.sol/97/run-latest.json). When set, the
# poisoning check scans every Relayed event since deployment, not just the recent window below.
KURIR_DEPLOY_BLOCK=133031061
# Fallback window if the RPC refuses the full range (5,000 blocks ≈ 37 min on BSC testnet)
LOG_LOOKBACK_BLOCKS=5000

# --- LLM explanations (optional) ---
# With neither LLM_BASE_URL nor OPENAI_API_KEY set, the fixed Bahasa templates are used (zero cost).
# Free local option (Ollama): LLM_BASE_URL=http://localhost:11434/v1, OPENAI_MODEL=qwen3:4b-instruct
# (use a NON-thinking model: the "thinking" qwen3 builds spend the whole answer reasoning).
LLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Slower than this → the template is used instead, so a demo can't hang on the LLM
LLM_TIMEOUT_MS=10000
# Ollama only: keep the model loaded (cold load ~11 s on an 8 GB M1)
LLM_KEEP_ALIVE=2h

PORT=8787
